<?xml version="1.0" encoding="utf-8"?>
<!--
  Roll widget (RollWidgetProvider). RemoteViews only allows plain framework
  views, so this sticks to LinearLayout / TextView / ImageView / ProgressBar.

    ‹  Roll name                        ◉
       Kodak Portra 400 · or a status
       ▬▬▬▬▬▬▭▭▭▭  12 / 36             ›
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roll_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/roll_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/roll_widget_prev"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:contentDescription="@string/roll_widget_previous"
        android:scaleType="center"
        android:src="@drawable/ic_widget_chevron_left" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/roll_widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF5EEDC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roll_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFD4A853"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/roll_widget_frames_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/roll_widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/roll_widget_progress" />

            <TextView
                android:id="@+id/roll_widget_frames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B3F5EEDC"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/roll_widget_shutter"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/roll_widget_shutter_bg"
        android:contentDescription="@string/roll_widget_shoot"
        android:padding="13dp"
        android:src="@drawable/ic_widget_camera" />

    <ImageView
        android:id="@+id/roll_widget_next"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:contentDescription="@string/roll_widget_next"
        android:scaleType="center"
        android:src="@drawable/ic_widget_chevron_right" />
</LinearLayout>
