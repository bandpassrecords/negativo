<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera widget: a single 1×1 cell. It never changes, so there is no periodic
  update (updatePeriodMillis="0").
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/camera_widget_description"
    android:initialLayout="@layout/camera_widget"
    android:previewLayout="@layout/camera_widget"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
